{
  "name": "dsh-plugin-onenote",
  "version": "0.2.3",
  "description": "Read the Microsoft OneNote notebooks you allow, from DeepSeek Harness. Device-code sign-in and a per-notebook allow-list you control in Settings. · 让 DSH 读取你勾选的 OneNote 笔记本：设备码登录，笔记本白名单在设置页勾选。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "hestudio-community",
  "homepage": "https://github.com/hestudio-community/dsh-plugin-onenote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hestudio-community/dsh-plugin-onenote.git"
  },
  "bugs": {
    "url": "https://github.com/hestudio-community/dsh-plugin-onenote/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "onenote",
    "microsoft-graph",
    "notes"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0"
  },
  "scripts": {
    "test": "node --import ./test/support/stub-tools.mjs --test \"test/*.test.js\"",
    "test:watch": "node --import ./test/support/stub-tools.mjs --test --watch \"test/*.test.js\"",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon-180": "./assets/icon-180.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
